# Production — copy to backend/.env.prod and fill every empty secret before deploy.
#   cp backend/.env.prod.example backend/.env.prod
#
# Compose also reads this file via --env-file backend/.env.prod for ${SECRET_KEY} substitution.

ENVIRONMENT=production
APP_ENV=prod
DEBUG=false

# Required — no defaults (generate: openssl rand -hex 32)
SECRET_KEY=

# PostgreSQL
POSTGRES_USER=erp
POSTGRES_DB=erp_db
POSTGRES_PASSWORD=

# MinIO
MINIO_ACCESS_KEY=erp-minio
MINIO_ROOT_PASSWORD=

# Same-origin behind nginx — leave empty so the web app uses relative /api paths.
# Rebuild the web image after changing this value.
NEXT_PUBLIC_API_BASE_URL=

# Public URL clients use for WebSocket/SSE (scheme + host, no trailing slash).
# Example: https://erp.example.com or http://localhost
REALTIME_PUBLIC_BASE_URL=

# CORS — browser origin for the admin UI
CORS_ORIGINS=http://localhost

# Optional scaling
WORKER_REPLICAS=2
MAINTENANCE_INTERVAL_SECONDS=300

# Metrics — required for production monitoring access (generate: openssl rand -hex 24)
METRICS_API_KEY=
