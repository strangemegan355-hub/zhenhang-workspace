# Production — copy to backend/.env.prod and fill every empty secret before deploy.
#   cp backend/.env.prod.example backend/.env.prod
#
# Compose also reads this file via --env-file backend/.env.prod for ${SECRET_KEY} substitution.

ENVIRONMENT=production
APP_ENV=prod
DEBUG=false

# Required — no defaults (generate: openssl rand -hex 32)
SECRET_KEY=

# PostgreSQL
POSTGRES_USER=erp
POSTGRES_DB=erp_db
POSTGRES_PASSWORD=

# MinIO
MINIO_ACCESS_KEY=erp-minio
MINIO_ROOT_PASSWORD=

# Same-origin behind nginx — leave empty so the web app uses relative /api paths.
# Rebuild the web image after changing this value.
NEXT_PUBLIC_API_BASE_URL=

# Public URL clients use for WebSocket/SSE (scheme + host, no trailing slash).
# Example: https://erp.example.com or http://localhost

# CORS — browser origin for the admin UI
CORS_ORIGINS=["http://localhost"]

# Optional scaling
MAINTENANCE_INTERVAL_SECONDS=300

# Metrics — required for production monitoring access (generate: openssl rand -hex 24)
METRICS_API_KEY=

# --- Optional knobs that have real code defaults (nothing here is required) ---
# Realtime event retention. Hot rows are archived past the hot window; archive rows are purged past the
# archive window. Ranges are validated, so a value outside them fails at start-up rather than silently.
# REALTIME_HOT_RETENTION_DAYS=7          # 1-90
# REALTIME_ARCHIVE_RETENTION_DAYS=90     # 7-365
# REALTIME_REPLAY_RETENTION_DAYS=3       # 1-30
# REALTIME_RETENTION_BATCH_SIZE=2000     # 100-20000
# REALTIME_TICKET_EXPIRE_SECONDS=300     # 30-3600; the transport credential a URL carries
# Token lifetimes.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_MINUTES=10080
# The tenant every bootstrap/seed path assigns when a row has none.
# DEFAULT_TENANT_CODE=default
# Machine/MES signals. Enable only where a gateway actually publishes them.
# MES_ENABLED=false
# MES_SIGNAL_STALE_SECONDS=300
# Branding used in generated exports.
# COMPANY_NAME=
# COMPANY_EXPORT_FOOTER=
