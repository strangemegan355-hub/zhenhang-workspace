# Local development — copy to backend/.env and fill secrets.
#   cp backend/.env.example backend/.env

APP_NAME=Zhenhang ERP API
APP_ENV=local
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Required — generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL (async URL)
# Default below matches docker-compose.yml host port 5432.
# Integration / local hybrid API often uses compose under backend/integration_tests
# (host port 55432). If seed/API talk past each other, set explicitly, e.g.:
#   DATABASE_URL=postgresql+psycopg://erp:erp@127.0.0.1:55432/erp_db
# Prefer 127.0.0.1 over localhost on Windows (IPv6 dual-stack delay).
DATABASE_URL=postgresql+psycopg://erp:erp@127.0.0.1:5432/erp_db

# Redis
# 127.0.0.1 rather than localhost: on Windows the name resolves to 127.0.0.1 and ::1 and the client
# spends ~21 s across both before connecting (measured: 21.07 s vs 0.00 s).
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO — leave empty in committed examples; local compose injects throwaway defaults
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=erp-files

# CORS — JSON array (pydantic-settings list field); comma form also works in Docker Compose env
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# Enterprise stabilization
DEFAULT_TENANT_CODE=default
REALTIME_HOT_RETENTION_DAYS=7
REALTIME_REPLAY_RETENTION_DAYS=3
REALTIME_ARCHIVE_RETENTION_DAYS=90
REALTIME_RETENTION_BATCH_SIZE=2000
MAINTENANCE_INTERVAL_SECONDS=300
MES_ENABLED=true
MES_SIGNAL_STALE_SECONDS=120

# Metrics (optional in dev; required in production — see ENTERPRISE_DEPLOYMENT.md)
# METRICS_API_KEY=

# Export branding (used in quote PDF/Excel templates)
COMPANY_NAME=振航智能制造
COMPANY_EXPORT_FOOTER=本报价单由振航 ERP 工业报价模块生成，具有版本追溯能力。

# Web admin (local dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
