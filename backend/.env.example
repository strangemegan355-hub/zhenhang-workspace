# Application
APP_NAME=Zhenhang ERP API
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1

# Security (generate strong secrets for production)
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL (async URL)
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp_db

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=erp-files

# CORS (comma-separated origins; empty = none)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Enterprise stabilization
DEFAULT_TENANT_CODE=default
REALTIME_HOT_RETENTION_DAYS=7
REALTIME_REPLAY_RETENTION_DAYS=3
REALTIME_ARCHIVE_RETENTION_DAYS=90
REALTIME_RETENTION_BATCH_SIZE=2000
MAINTENANCE_INTERVAL_SECONDS=300
MES_ENABLED=true
MES_SIGNAL_STALE_SECONDS=120

# Production compose (docker-compose.prod.yml)
# POSTGRES_PASSWORD=
# WORKER_REPLICAS=2
