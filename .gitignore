.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
backend/.env.prod
.idea/
.vscode/

node_modules/
apps/*/node_modules/
.next/
dist/
build/
coverage/
*.log

# local env files created by the runbook (examples stay tracked)
apps/*/.env.local
backend/.env
backend/.env.local

# local TLS material — generated, must never be committed
deploy/nginx/certs/*.pem
deploy/nginx/certs/*.key
deploy/nginx/certs/*.crt

# scratch files left behind by tooling runs
scripts/_s_test.json
scripts/_verify.txt

# local trial passwords / agent scratch (never commit)
logs/
logs/*.local.env
logs/trial-passwords*
.tmp_*

# docker compose runtime data (placeholders under volumes/**/.gitkeep stay tracked)
volumes/postgres/data/
volumes/minio/.minio.sys/
volumes/redis/appendonlydir/
volumes/nginx/logs/*
!volumes/nginx/logs/.gitkeep

